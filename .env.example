# Azure Storage Account
STORAGE_ACCOUNT_NAME="your_storage_account_name"
STORAGE_ACCOUNT_URL="https://<your_storage_account_name>.blob.core.windows.net"

# Azure AI Document Intelligence
DOCUMENT_INTELLIGENCE_ENDPOINT="https://<your_doc_intel_name>.cognitiveservices.azure.com/"

# Azure AI Search
AI_SEARCH_SERVICE_ENDPOINT="https://<your_search_service_name>.search.windows.net"
INDEX_NAME="books-index-ailp"
EMBEDDING_MODEL_DEPLOYMENT_NAME="text-embedding-3-small"

# Azure AI Foundry / Azure OpenAI Service
AZURE_OPENAI_ENDPOINT="https://<your_foundry_account_name>.cognitiveservices.azure.com/"
AZURE_PROJECT_ENDPOINT="https://<your_foundry_account_name>.services.ai.azure.com/api/projects/<your_project_name>"
AGENT_MODEL_DEPLOYMENT_NAME="agent-llm"
LTM_AGENT_MODEL_DEPLOYMENT_NAME="ltm-agent-llm"
TUTOR_EXTRACTOR_MODEL_DEPLOYMENT_NAME="tutor-extractor-llm"

# Azure Cosmos DB (Checkpoints, BaseStore & User Gradings)
COSMOS_ENDPOINT="https://<your_cosmos_account_name>.documents.azure.com:443/"
COSMOS_DATABASE_NAME="CosmosStore"
COSMOS_CONTAINER_NAME="store"
COSMOS_CHECKPOINTS_CONTAINER_NAME="checkpoints"
COSMOS_USER_GRADINGS_CONTAINER_NAME="UserGradings"

# Azure AI Content Safety
CONTENT_SAFETY_ENDPOINT="https://<your_content_safety_name>.cognitiveservices.azure.com/"
CONTENT_SAFETY_NAME="<your_content_safety_name>"

# Azure Container Apps Dynamic Sessions (Code Sandbox)
AZURE_SESSION_POOL_ENDPOINT="https://<region>.dynamicsessions.io/subscriptions/<sub_id>/resourceGroups/<rg>/sessionPools/<pool_name>"
AZURE_SESSION_POOL_NAME="sessions-ailp-<unique_suffix>"

# Azure Application Insights & OpenTelemetry Observability
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/;ApplicationId=<app_id>"

# Optional: Disable noisy low-level Azure SDK HTTP telemetry to keep trace view focused on agent spans
# OTEL_PYTHON_DISABLED_INSTRUMENTATIONS="azure_core_tracing_opentelemetry,urllib3,urllib"

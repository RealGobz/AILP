      "properties": {
        "model": {
          "format": "DeepSeek",
          "name": "DeepSeek-V4-Flash",
          "version": "2026-04-23"
        }
      },
      "dependsOn": [
        "aiFoundry",
        "ltmModel"
      ]
    },
    "aiProject": {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', parameters('foundryAccountName'), parameters('foundryProjectName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"

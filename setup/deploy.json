      "properties": {
        "resource": {
          "id": "[parameters('cosmosUserGradingsContainerName')]",
          "partitionKey": {
            "paths": [
              "/userId"
            ],
            "kind": "Hash"
          },
          "defaultTtl": -1,
          "indexingPolicy": {
            "indexingMode": "consistent",
            "includedPaths": [
              {
                "path": "/*"
              }
            ],
            "excludedPaths": [
              {
                "path": "/\"_etag\"/?"
              }
            ]
          }
        },
        "options": {
          "throughput": "[parameters('cosmosThroughput')]"
        }
      },
      "dependsOn": [
        "sqlDatabase"
      ]

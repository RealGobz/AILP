      "sku": {
        "name": "Standard",
        "capacity": 20
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "text-embedding-3-small",
          "version": "1"
        }
      },
      "dependsOn": [
        "aiFoundry"
      ]
    },

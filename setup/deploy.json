    "appInsightsConnection": {
      "type": "Microsoft.CognitiveServices/accounts/projects/connections",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}/{2}', parameters('foundryAccountName'), parameters('foundryProjectName'), 'appinsights-connection')]",
      "properties": {
        "category": "AppInsights",
        "target": "[resourceId('Microsoft.Insights/components', toLower(parameters('appInsightsName')))]",
        "authType": "ApiKey",
        "metadata": {
